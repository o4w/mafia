# Railway'de bu değişkenleri Variables sekmesine gir
# PostgreSQL ve Redis servislerini ekleyince bazıları otomatik gelir

# Django
SECRET_KEY=buraya-cok-guclu-rastgele-bir-key-yaz
DEBUG=False
ALLOWED_HOSTS=*

# Database - Railway PostgreSQL eklersen DATABASE_URL otomatik gelir
# Manuel ayarlamak istersen:
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=...
# DB_HOST=...
# DB_PORT=5432

# Redis - Railway Redis eklersen REDIS_URL otomatik gelir
# REDIS_URL=redis://...

# CORS - Frontend URL'ini buraya yaz
CORS_ALLOWED_ORIGINS=https://senin-frontend-urlin.com
